{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wezen",
  "version": "0.2.0",
  "identifier": "dev.wezen.monitor",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "monitor",
        "title": "Wezen",
        "url": "monitor.html",
        "width": 340,
        "height": 440,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "maximizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Windows のリソースの使用状況を小さなグラフで表示する",
    "copyright": "Copyright (c) 2026 nanase"
  }
}
